# Local defaults need no API keys. The model is downloaded on first use.
# Leave the engine unset for automatic selection: prepared Apex, then Swift,
# then the Apple Silicon MLX fallback.
# BOL_ENGINE=sherpa-hinglish
# BOL_HINGLISH_MODEL_DIR=data/models/hinglish-swift/hi-hinglish-swift
# Apple Silicon local accuracy pass: use MLX large-v3-turbo to verify English
# words while the Hinglish specialist preserves Hindi/English code-switching.
# BOL_ENGLISH_VERIFY_MODEL=mlx-community/whisper-large-v3-turbo
# BOL_MODEL=mlx-community/whisper-large-v3-turbo
# CPU/CUDA alternative: install requirements-cpu.txt and use BOL_ENGINE=faster-whisper
# BOL_MODEL=large-v3-turbo
# BOL_DEVICE=cpu
# BOL_COMPUTE_TYPE=int8
# Vercel frontend: set this to the HTTPS worker API's origin.
VITE_API_BASE=
# Must match BOL_API_KEY on the worker when that is set. Ships in the bundle.
VITE_API_KEY=
# Comma-separated frontend origins allowed to access the worker.
BOL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployment hardening -----------------------------------------------------
# Both are optional and unset locally, where the API is open and CORS allows the
# Vite dev server.

# Shared key. When set, every /api route requires it as an X-API-Key header, an
# or a ?key= query parameter (media and download URLs are loaded by
# <video src>/<img src>, which cannot send headers). Authorization: Bearer is
# no longer accepted for it — that header carries the signed-in user's token.
# The frontend sends it via VITE_API_KEY, so the value ships inside the bundle:
# it deters drive-by traffic against a public deployment, it is not per-user
# authentication.
# BOL_API_KEY=change-me

# Comma-separated origins allowed to call the API from a browser. Defaults to
# the local dev server. Set this to your frontend's origin in production — an
# unset value used to mean "*", which reflected any Origin back.
# BOL_ALLOWED_ORIGINS=https://your-frontend.example

# Longest clip this deployment will render, in seconds. Unset means no limit,
# which is right locally. Rendering is CPU work (headless Chromium + libx264,
# no GPU): a 20-minute export measured 26 minutes on an M2, and a Space's
# shared vCPUs are slower still, so a long clip can outrun the two-hour
# watchdog and lose its output to a container restart. The editor reads this
# from /api/limits and says so before you start editing.
# 180 = three minutes, which covers most reels and shorts.
# BOL_MAX_EXPORT_SECONDS=180

# --- Accounts (Supabase Auth) -------------------------------------------------
# Unset, there are no accounts: the app falls back to the random workspace id the
# browser keeps in localStorage, which is what lets `npm run dev` work with no
# configuration at all. Auth switches on by being configured, the same way the
# API key does.
#
# Supabase holds the accounts and hashes the passwords. This backend never sees
# one — it only verifies the ES256 signature on an access token against the
# public keys Supabase publishes, and reads the user id out of it.
# BOL_SUPABASE_URL=https://your-project.supabase.co

# Optional override. Derived from BOL_SUPABASE_URL when unset.
# BOL_SUPABASE_JWKS_URL=

# Signs the short-lived tokens in media URLs. <video src> cannot send headers,
# and an access token in a query string would leak a real credential into proxy
# logs, browser history and Referer — so media carries a token that can read one
# project's media for fifteen minutes and do nothing else. Unset, a random value
# is generated per boot, which is fine for a single-process deployment: it only
# means outstanding media URLs stop working after a restart.
# BOL_MEDIA_SECRET=

# The frontend needs these at build time. Both are public by design — the anon
# key is what @supabase/supabase-js is meant to ship with, the same category as
# VITE_API_KEY above.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# NOT the service role key. It is never needed here: verifying a signature uses
# the public half, and nothing in this backend calls the Supabase API. Anything
# named VITE_* is inlined into public JavaScript by Vite, so putting it there
# would publish full database access to every visitor. If a feature ever seems
# to need it, that is a reason to stop and reconsider the feature.

# Optional analytics. Public ingestion keys only; never put reporting secrets in VITE_.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_REPLAY=0
VITE_SENTRY_DSN=
VITE_APP_RELEASE=
# Backend-only reporting credentials. See docs/ANALYTICS_SETUP.md.
BOL_ADMIN_USER_IDS=
BOL_VERCEL_ANALYTICS_TOKEN=
BOL_VERCEL_PROJECT_ID=
BOL_VERCEL_TEAM_ID=
BOL_POSTHOG_PERSONAL_API_KEY=
BOL_POSTHOG_PROJECT_ID=
BOL_POSTHOG_API_HOST=https://us.posthog.com
BOL_POSTHOG_DASHBOARD_URL=
BOL_SENTRY_DSN=
BOL_SENTRY_READ_TOKEN=
BOL_SENTRY_ORG=
BOL_SENTRY_PROJECT=
BOL_SENTRY_DASHBOARD_URL=

# Server-only owner PIN. Never use a VITE_ prefix.
BOL_ADMIN_PIN=
