# Local defaults need no API keys. The model is downloaded on first use.
# Leave the engine unset for automatic selection: prepared Apex, then Swift,
# then the Apple Silicon MLX fallback.
# BOL_ENGINE=sherpa-hinglish
# BOL_HINGLISH_MODEL_DIR=data/models/hinglish-swift/hi-hinglish-swift
# Apple Silicon local accuracy pass: use MLX large-v3-turbo to verify English
# words while the Hinglish specialist preserves Hindi/English code-switching.
# BOL_ENGLISH_VERIFY_MODEL=mlx-community/whisper-large-v3-turbo
# BOL_MODEL=mlx-community/whisper-large-v3-turbo
# CPU/CUDA alternative: install requirements-cpu.txt and use BOL_ENGINE=faster-whisper
# BOL_MODEL=large-v3-turbo
# BOL_DEVICE=cpu
# BOL_COMPUTE_TYPE=int8
# Vercel frontend: set this to the HTTPS worker API's origin.
VITE_API_BASE=
# Must match BOL_API_KEY on the worker when that is set. Ships in the bundle.
VITE_API_KEY=
# Comma-separated frontend origins allowed to access the worker.
BOL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployment hardening -----------------------------------------------------
# Both are optional and unset locally, where the API is open and CORS allows the
# Vite dev server.

# Shared key. When set, every /api route requires it as an X-API-Key header, an
# Authorization: Bearer token, or a ?key= query parameter (media and download
# URLs are loaded by <video src>/<img src>, which cannot send headers).
# The frontend sends it via VITE_API_KEY, so the value ships inside the bundle:
# it deters drive-by traffic against a public deployment, it is not per-user
# authentication.
# BOL_API_KEY=change-me

# Comma-separated origins allowed to call the API from a browser. Defaults to
# the local dev server. Set this to your frontend's origin in production — an
# unset value used to mean "*", which reflected any Origin back.
# BOL_ALLOWED_ORIGINS=https://your-frontend.example

# Longest clip this deployment will render, in seconds. Unset means no limit,
# which is right locally. Rendering is CPU work (headless Chromium + libx264,
# no GPU): a 20-minute export measured 26 minutes on an M2, and a Space's
# shared vCPUs are slower still, so a long clip can outrun the two-hour
# watchdog and lose its output to a container restart. The editor reads this
# from /api/limits and says so before you start editing.
# 180 = three minutes, which covers most reels and shorts.
# BOL_MAX_EXPORT_SECONDS=180
