{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://n3owise-bol-studio-backend.hf.space/api/:path*"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/studio/:path*",
      "destination": "/studio.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/studio.html"
    },
    {
      "source": "/hinglish-captions",
      "destination": "/hinglish-captions.html"
    },
    {
      "source": "/hindi-subtitles",
      "destination": "/hindi-subtitles.html"
    },
    {
      "source": "/reels-captions",
      "destination": "/reels-captions.html"
    },
    {
      "source": "/youtube-shorts-subtitles",
      "destination": "/youtube-shorts-subtitles.html"
    },
    {
      "source": "/caption-styles",
      "destination": "/caption-styles.html"
    }
  ],
  "functions": {
    "api/admin/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bol-studio.me"
        }
      ],
      "destination": "https://www.bol-studio.me/:path*",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
